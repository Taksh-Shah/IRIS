<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- targetSdk 34 (AC-9): INTERNET is implicitly granted; the SDK-37
         ACCESS_LOCAL_NETWORK cliff (data plane = TCP/UDP/mDNS/DNS-SD) is
         deliberately avoided for v1. See ANDROID_DESIGN.md §8. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Foreground service: connectedDevice type (AC-7, API 34+) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- BLE control plane: legacy pre-31 + runtime 31+ (BLE-001 pattern) -->
    <uses-permission android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="31" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE"
        tools:targetApi="31" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT"
        tools:targetApi="31" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Wi-Fi Aware / Wi-Fi Direct discovery (never-for-location) -->
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="33" />

    <!-- HW-10: Wi-Fi Direct's own control-plane permissions — distinct from
         NEARBY_WIFI_DEVICES above, and never declared before this. Confirmed
         live: `WifiP2pManager.initialize()` -> `getMessenger()` ->
         `WifiP2pServiceImpl.enforceAccessPermission()` throws a
         RemoteException on EVERY real device tested (Android 12/14/16 —
         three different OEMs), which `AndroidWifiDirectTransportAdapter`
         swallowed into an undifferentiated `NotSupported`/"required
         hardware not present on this device." That symptom is what every
         static review before this pass, and this pass's own initial live
         testing, read as "no Wi-Fi Direct hardware" — but normal
         (non-runtime, install-time-only) `ACCESS_WIFI_STATE` and
         `CHANGE_WIFI_STATE` were never in this manifest at all, so the
         platform's own service-side permission enforcement failed
         identically regardless of what hardware or OEM was underneath. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- OEM battery-kill UX: user-initiated exemption request only (AC-7) -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Hardware features — all optional (graceful degradation per capability gate) -->
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />
    <uses-feature android:name="android.hardware.wifi.aware" android:required="false" />
    <uses-feature android:name="android.hardware.wifi.direct" android:required="false" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <application
        android:name=".IrisApplication"
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Iris">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- connectedDevice FGS: BLE control plane durable trigger + Wi-Fi
             Direct re-arm window + Wi-Fi Aware production discovery (AC-7). -->
        <service
            android:name=".service.IrisBleService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- BLE PendingIntent scan receiver (AC-7, API 26+). -->
        <receiver
            android:name=".service.BleScanReceiver"
            android:exported="false" />
    </application>

</manifest>
